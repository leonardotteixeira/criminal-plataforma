# Copie para .env para sobrescrever os padrões do docker-compose.yml
SINALBR_CORS=http://localhost:3000
SINALBR_K_MIN=5
NEXT_PUBLIC_API_URL=http://localhost:8000
# Contagens por hexágono arredondadas para múltiplos deste valor (proteção contra diferenciação; 1 desliga)
SINALBR_CELL_ROUND=5
# Nome exibido pela API em /v1/meta (a marca do site fica em web/src/config/brand.ts)
SINALBR_BRAND=SinalBR
